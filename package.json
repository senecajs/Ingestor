{
  "name": "@seneca/ingestor",
  "version": "0.1.0",
  "description": "Seneca ingestor plugin — reads files from a storage folder and writes structured entities.",
  "main": "dist/Ingestor.js",
  "type": "commonjs",
  "types": "dist/Ingestor.d.ts",
  "license": "MIT",
  "author": "Richard Rodger (http://richardrodger.com)",
  "contributors": [
    "Richard Rodger (http://richardrodger.com)"
  ],
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test-some": "NODE_OPTIONS=--experimental-vm-modules jest -t",
    "test-watch": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --watchAll",
    "watch": "tsc -w -d",
    "build": "tsc -d",
    "doc": "seneca-doc -p @seneca/entity",
    "prettier": "prettier --write --no-semi --single-quote src/**/*.ts test/*.js",
    "reset": "npm run clean && npm i && npm run build && npm test",
    "clean": "rm -rf node_modules dist package-lock.json yarn.lock"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senecajs/Ingestor.git"
  },
  "keywords": [
    "seneca",
    "plugin",
    "ingestor",
    "pdf",
    "xlsx"
  ],
  "peerDependencies": {
    "@seneca/entity": "^29.0.0",
    "seneca": "^4.0.0"
  },
  "devDependencies": {
    "@seneca/doc": "^9.0.0",
    "@seneca/entity": "^29.0.0",
    "@seneca/maintain": "^0.1.0",
    "@seneca/s3-store": "^3.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.0",
    "@types/pdf-parse": "^1.1.5",
    "docx": "^9.7.1",
    "esbuild": "^0.20.1",
    "esbuild-jest": "^0.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "seneca": "^4.0.0",
    "typescript": "^5.3.3"
  },
  "files": [
    "README.md",
    "CHANGES.md",
    "LICENSE",
    "src",
    "dist"
  ],
  "dependencies": {
    "file-type": "^14.7.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
